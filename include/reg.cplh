#ifndef REG_H_
#define REG_H_ 0

#include <string_h.cpl>

#define R0 0
#define R1 1
#define R2 2
#define R3 3
#define R4 4
#define R5 5
#define R6 6
#define R7 7

:/ The LC-3 has eight 16-bit general purpose registers R0 to R7.
This is the general purpose registers of the machine
/:
container regs {
    arr registers[8, u16];
    
    @[self] @[inline(model)] @[abi]
    function init(ptr regs self) -> i0;
    
    @[self] @[inline(model)] 
    function set(ptr regs self, i8 r, u16 data) -> i0;
    
    @[self] @[inline(model)] 
    function get(ptr regs self, i8 r) -> u16;
}

#endif
