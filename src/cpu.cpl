:/ This is the main logic file where we implement CPU logic.
   The main routine is execute function, where every instruction is decoded
   and executed. /:
#include "../include/cpu.cplh"

function cpu::init(ptr cpu self) -> i0 {
    self.registers.init();
    self.pc = 0i16;
}

function cpu::load_code(ptr cpu self, ptr u16 code, i16 code_size) -> i0 {
    self.memory.init(code, code_size);
}

function cpu::fetch(ptr cpu self) -> u16 {
    u16 inst = self.memory.code[self.pc];
    self.pc += 1i16;
    inst
}

:/ Get register index from an instruction u16 word. The u16 word usually looks like this:
0000_0000_0000_0000 - 16 bits. Register index bits always placed as a bits that can be divided by 3.
For instance:
0_000_000_000_000_000
        ^   ^   ^   
        dr1 sr1 sr2
/:
@[inline(never)] function get_reg_index(u16 inst, i8 idx) -> i8 {
    (inst >> (idx * 3)) & 0b111
}

function cpu::execute(ptr cpu self, u16 inst) -> i0 {
    i8 opcode = (inst >> 12) & 0b1111i8;
    @[no_fall] switch opcode; {
        :/ not dr, sr + NZP /:
        case NOT; {
            i8 dr   = get_reg_index(inst, 3);
            i8 sr   = get_reg_index(inst, 2);
            u16 res = neg self.registers.get(sr);
            self.registers.set(dr, res);
            self.registers.set_nzp(res);
        }
        :/ trap <code> /:
        case TRAP; {
            i8 trap = inst & 0b1111111i8;
            @[no_fall] @[straight] switch trap; {
                case 0x20; self.registers.set(R0, getc(stdin) as u16);
                case 0x21; putc((self.registers.get(R0) & 0b11111111u16) as i32, stdout);
                case 0x22; {
                    u16 addr = self.registers.get(R0);
                    while self.memory.get(addr); {
                        putc((self.memory.get(addr) & 0xFF) as i32, stdout);
                        addr = addr + 1;
                    }
                }
                @[fall] case 0x23; {}
                case 0x25; {
                    printf(ref "\n");
                    loop {}
                }
            }
        }
        :/ jsr /:
        case JSR; {
            self.registers.set(R7, self.pc as u16);
            if (inst >> 11) & 0b1; self.pc += inst |~ 11i16;
            else {
                i8 baseR = get_reg_index(inst, 2);
                self.pc = self.registers.get(baseR);
            }
        }
        :/ br<pzn> / ret /:
        case BR; {
            i8 p    = (inst >> 9)  & 0b1;
            i8 z    = (inst >> 10) & 0b1;
            i8 n    = (inst >> 11) & 0b1;
            i16 off = inst |~ 9i16;
            if 
                (self.registers.get_n() && n) ||
                (self.registers.get_z() && z) ||
                (self.registers.get_p() && p);
            self.pc += off;
        }
        :/ jmp <reg> /:
        case JMP; {
            i8 p = (inst >> 9)  & 0b1;
            i8 z = (inst >> 10) & 0b1;
            i8 n = (inst >> 11) & 0b1;
            if :/ ret case /:
                not p && not z && not n &&
                get_reg_index(inst, 2) == 0b111i8;
            {
                self.pc = self.registers.get(R7);
                break;
            }
            
            i8 baseR = get_reg_index(inst, 2);
            self.pc = self.registers.get(baseR);
        }
        :/ lea dr, <addr> /:
        case LEA; {
            i8 dr   = get_reg_index(inst, 3);
            i16 off = inst |~ 9i16;
            u16 res = off + self.pc;
            self.registers.set(dr, res);
            self.registers.set_nzp(res);
        }
        :/ ld dr, <addr> /:
        case LD; {
            i8 dr   = get_reg_index(inst, 3);
            i16 off = inst |~ 9i16;
            u16 res = self.memory.get(off + self.pc);
            self.registers.set(dr, res);
            self.registers.set_nzp(res);
        }
        :/ ldi dr, <addr> /:
        case LDI; {
            i8 dr    = get_reg_index(inst, 3);
            i16 off = inst |~ 9i16;
            u16 pres = self.memory.get(off + self.pc);
            u16 res  = self.memory.get(pres);
            self.registers.set(dr, res);
            self.registers.set_nzp(res);
        }
        :/ ldr dr, baseR, <addr> /:
        case LDR; {
            i8 dr    = get_reg_index(inst, 3);
            i8 baseR = get_reg_index(inst, 2);
            i16 off  = inst |~ 6i16;

            u16 addr = self.registers.get(baseR) + off;
            u16 res  = self.memory.get(addr);

            self.registers.set(dr, res);
            self.registers.set_nzp(res);
        }
        :/ st sr, <addr> /:
        case ST; {
            i8 sr   = get_reg_index(inst, 3);
            i16 off = inst |~ 9i16;
            self.memory.set(off + self.pc, self.registers.get(sr));
        }
        :/ sti sr, <addr> /:
        case STI; {
            i8 dr    = get_reg_index(inst, 3);
            i16 off  = inst |~ 9i16;
            u16 pres = self.memory.get(off + self.pc);
            self.memory.set(pres, self.registers.get(dr));
        }
        :/ str sr, <addr> /:
        case STR; {
            i8 sr    = get_reg_index(inst, 3);
            i8 baseR = get_reg_index(inst, 2);
            i16 off  = inst |~ 6i16;
            u16 addr = self.registers.get(baseR) + off;
            self.memory.set(addr, self.registers.get(sr));
        }
        :/ and dr, sr1 / imm /:
        case AND; {
            u16 res;
            i8 dr  = get_reg_index(inst, 3);
            i8 sr1 = get_reg_index(inst, 2);
            if (inst >> 5) & 0b1; {
                res = self.registers.get(sr1) & (inst & 0b11111) as i16;
                self.registers.set(dr, res);
            }
            else {
                i8 sr2 = inst & 0b111;
                res = self.registers.get(sr1) & self.registers.get(sr2);
                self.registers.set(dr, res);
            }

            self.registers.set_nzp(res);
        }
        :/ add dr, sr1, sr2 / imm /:
        case ADD; {
            u16 res;
            i8 dr  = get_reg_index(inst, 3);
            i8 sr1 = get_reg_index(inst, 2);

            if ((inst >> 5) & 0b1) as i32; {
                i16 imm5 = inst |~ 5i16;
                res = self.registers.get(sr1) + imm5;
                self.registers.set(dr, res);
            }
            else {
                i8 sr2 = inst & 0b111;
                res = self.registers.get(sr1) + self.registers.get(sr2);
                self.registers.set(dr, res);
            }

            self.registers.set_nzp(res);
        }
    }
}
