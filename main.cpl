#include "include/cpu.cplh"
#include <stdio_h.cpl>

start() {
    cpu c;
    c.init();

    arr code[20, u16] = {
        0b0101000000100000 as u16, :/  0: and r0, r0, #0      -> r0 = 0               /:
        0b0001000000100011 as u16, :/  1: add r0, r0, #3      -> r0 = 3               /:
        0b0101001001100000 as u16, :/  2: and r1, r1, #0      -> r1 = 0               /:
        0b0001001001100101 as u16, :/  3: add r1, r1, #5      -> r1 = 5               /:
        0b0001010000000001 as u16, :/  4: add r2, r0, r1      -> r2 = 8               /:
        0b0101011010100111 as u16, :/  5: and r3, r2, #7      -> r3 = 0               /:
        0b0101100010000001 as u16, :/  6: and r4, r2, r1      -> r4 = 0               /:
        0b0011010000001011 as u16, :/  7: st r2, #11          -> memory[19] = 8       /:
        0b0010101000001010 as u16, :/  8: ld r5, #10          -> r5 = memory[19] = 8  /:
        0b1110110000000010 as u16, :/  9: lea r6, #2          -> r6 = 12              /:
        0b1100000110000000 as u16, :/ 10: jmp r6              -> pc = 12              /:
        0b0001000000100001 as u16, :/ 11: add r0, r0, #1      -> MUST BE SKIPPED      /:
        0b0001000000100010 as u16, :/ 12: add r0, r0, #2      -> r0 = 5               /:
        0b0001000000101111 as u16, :/ 13: add r0, r0, #15     -> r0 = 20              /:
        0b0001000000101111 as u16, :/ 14: add r0, r0, #15     -> r0 = 35              /:
        0b0001000000101111 as u16, :/ 15: add r0, r0, #15     -> r0 = 50              /:
        0b0001000000100011 as u16, :/ 16: add r0, r0, #3      -> r0 = 53 ('5')        /:
        0b1111000000100001 as u16, :/ 17: trap x21            -> print '5'            /:
        0b1111000000100101 as u16, :/ 18: trap x25            -> HALT                 /:
        0b0000000000000000 as u16  :/ 19: data for ST/LD                              /:
    };

    c.load_code(ref code, sizeof(code) as i16);

    u16 inst = c.fetch();
    while inst; {
        c.execute(inst);
        inst = c.fetch();
    }

    exit 0;
}
