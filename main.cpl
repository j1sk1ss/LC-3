#include "include/cpu.cplh"
#include <stdio_h.cpl>

@[abi]
start(i32 argc, ptr ptr i8 argv) {
    cpu c;
    c.init();

    ptr file f = file::open(argv[1], ref "rb");
    if not f; {
        printf(ref "%s is not found!\n", argv[1]);
        exit 1;
    }

    defer f.destroy();

    isize code_size = f.size();
    if code_size <= 0 || code_size % 2; {
        printf(ref "Size of code is %i!\n", code_size);
        exit 2;
    }

    ptr i8 buffer = malloc(code_size) as ptr i8;
    if not buffer; exit 4;

    defer free(buffer);

    if f.read(buffer, code_size) < 0; exit 5;
    c.load_code(buffer, (code_size) as i16);

    u16 inst = c.fetch();
    while inst; {
        c.execute(inst);
        inst = c.fetch();
    }

    exit 0;
}
